PORT=3001

# Supabase (use service role key so server bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Smallest AI (Waves TTS + Pulse STT)
SMALLEST_AI_API_KEY=

# Twilio (telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# LLM (optional — for future LLM-based answer validation)
OPENROUTER_API_KEY=

# Public URL of this server (used for Twilio callbacks and WS)
API_BASE_URL=https://your-server.railway.app

# Origin of the web app (for CORS)
WEB_ORIGIN=https://your-app.vercel.app
